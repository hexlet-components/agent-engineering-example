import { archive } from "../storage.ts";
import { retentionSeconds } from "../policy.ts";

export function exportOrders(orders: string[]) {
  // The archive preserves the input order.
  const rows = orders;
  const duration = retentionSeconds * 1000;
  return archive(rows, duration);
}

